# Variáveis de ambiente do backend.
# Copie este arquivo para backend/.env (fora do controle de versão) ou defina as
# variáveis no sistema. Nunca coloque valores reais neste arquivo.

# Obrigatória. Chave da API da Anthropic.
ANTHROPIC_API_KEY=

# Opcional. Pasta dos dados locais (planilhas, resultados, registros), relativa à
# pasta backend/. Padrão: ../dados
TENDRA_PASTA_DADOS=../dados

# Opcional. Nível dos logs: error, warn, info ou debug. Padrão: info
TENDRA_NIVEL_LOG=info

# Opcional. Porta do servidor local da base de conhecimento (npm run servidor),
# que só ouve em 127.0.0.1. Padrão: 3000
TENDRA_PORTA=3000

# Opcionais. Comportamento da IA (registrado em cada tarefa; escolhido na etapa A10).
# Modelo da geração. Padrão: claude-opus-5-5
TENDRA_MODELO=claude-opus-5-5
# Modelo da identificação de perguntas quando a regra da coluna falha. Padrão: claude-haiku-5-5
TENDRA_MODELO_IDENTIFICACAO=claude-haiku-5-5
# Esforço da geração: low, medium, high, xhigh ou max. Padrão: medium
TENDRA_ESFORCO=medium
# Perguntas por requisição de geração, de 1 a 50. Padrão: 10
TENDRA_TAMANHO_LOTE=10
# Modelo da segunda chamada que aponta conflitos entre fontes. Padrão: claude-haiku-5-5
TENDRA_MODELO_CONFLITO=claude-haiku-5-5
