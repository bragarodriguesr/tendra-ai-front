# Variáveis de ambiente do backend.
# Copie este arquivo para backend/.env (fora do controle de versão) ou defina as
# variáveis no sistema. Nunca coloque valores reais neste arquivo.

# Obrigatória. Chave da API da Anthropic.
ANTHROPIC_API_KEY=

# Fase D. Modo do servidor: local (padrão; fases A a C, só em 127.0.0.1, sem login) ou compartilhado
# (ambiente publicado). No modo compartilhado são obrigatórias ANTHROPIC_API_KEY, DATABASE_URL,
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY e TENDRA_ORIGEM_DO_FRONT. A chave de serviço do Supabase
# ignora as regras de acesso: fica só no cofre do Render e no .env local, nunca no front.
# TENDRA_MODO=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TENDRA_ORIGEM_DO_FRONT=
# Certificado (PEM) da autoridade do Postgres do Supabase (painel → Database → SSL Configuration),
# para conferir o TLS da conexão. Sem ele, a conexão remota é cifrada sem conferir o certificado.
# TENDRA_BANCO_CA=
# Horas sem uso até a sessão de login expirar (modo compartilhado). Padrão: 8
# TENDRA_SESSAO_HORAS=8

# Opcional (fase D). Conexão ao Postgres, por exemplo o do Supabase. Sem ela, o banco é o PGlite
# local em <TENDRA_PASTA_DADOS>/banco.
# DATABASE_URL=

# Opcional. Pasta dos dados locais (planilhas, resultados, registros), relativa à
# pasta backend/. Padrão: ../dados
TENDRA_PASTA_DADOS=../dados

# Opcional. Nível dos logs: error, warn, info ou debug. Padrão: info
TENDRA_NIVEL_LOG=info

# Opcional. Porta do servidor local da base de conhecimento (npm run servidor),
# que só ouve em 127.0.0.1. Padrão: 3000
TENDRA_PORTA=3000

# Opcionais. Comportamento da IA (registrado em cada tarefa; escolhido na etapa A10).
# Modelo da geração. Padrão: claude-sonnet-5-5 (temporário, para os testes; a recomendação da A10 é claude-opus-5-5)
TENDRA_MODELO=claude-sonnet-5-5
# Modelo da identificação de perguntas quando a regra da coluna falha. Padrão: claude-haiku-5-5
TENDRA_MODELO_IDENTIFICACAO=claude-haiku-5-5
# Esforço da geração: low, medium, high, xhigh ou max. Padrão: medium
TENDRA_ESFORCO=medium
# Perguntas por requisição de geração, de 1 a 50. Padrão: 10
TENDRA_TAMANHO_LOTE=10
# Modelo da segunda chamada que aponta conflitos entre fontes. Padrão: claude-sonnet-5-5
TENDRA_MODELO_CONFLITO=claude-sonnet-5-5
# Modelo do "Revisar com IA" das respostas manuais (só redação). Padrão: claude-haiku-5-5
TENDRA_MODELO_REVISAO_TEXTO=claude-haiku-5-5
# Modelo da classificação das perguntas por área (fase N). Padrão: claude-haiku-5-5
# TENDRA_MODELO_CLASSIFICACAO=claude-haiku-5-5
# Fase U. Modelo da classificação dos documentos da base por área. Padrão: claude-haiku-5-5
# TENDRA_MODELO_CLASSIFICACAO_DOCUMENTO=claude-haiku-5-5
# Fase U. Seleção da base por área na geração: true (padrão) ou false, que volta à base inteira.
# TENDRA_SELECAO_POR_AREA=true
# Fase U. Tokens da base ativa a partir dos quais a seleção liga. Padrão: 50000
# TENDRA_SELECAO_MINIMO_TOKENS=50000

# Só enquanto a chave não está configurada (pendência A1): 1 liga a API do Claude
# simulada no servidor, com respostas fictícias marcadas como "[Resposta simulada]".
# TENDRA_API_SIMULADA=1
