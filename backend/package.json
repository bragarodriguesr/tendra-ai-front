{
  "name": "tendra-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verificar-config": "node --env-file-if-exists=.env src/cli/verificarConfig.ts",
    "carregar-base": "node --env-file-if-exists=.env src/cli/carregarBase.ts",
    "gerar-amostra": "node --env-file-if-exists=.env src/cli/gerarAmostra.ts",
    "responder": "node --env-file-if-exists=.env src/cli/responder.ts",
    "avaliar": "node src/cli/avaliar.ts",
    "aceitacao": "node --env-file-if-exists=.env src/cli/aceitacao.ts",
    "servidor": "node --env-file-if-exists=.env src/cli/servidor.ts",
    "cadastrar-organizacao": "node --env-file-if-exists=.env src/cli/cadastrarOrganizacao.ts",
    "cadastrar-perfil": "node --env-file-if-exists=.env src/cli/cadastrarPerfil.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@electric-sql/pglite": "0.5.8",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "jszip": "3.10.2",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
